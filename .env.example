# =====================================================================
# GitAgentic Configuration File
# =====================================================================

# 1. LLM Provider Settings (OpenAI-compatible)
# For Groq:
#   LLM_BASE_URL="https://api.groq.com/openai/v1"
#   LLM_API_KEY="gsk_your_groq_api_key_here"
#   LLM_MODEL="llama-3.3-70b-versatile" (or "llama-3.1-8b-instant")
#
# For Ollama (Local - No API key needed):
#   LLM_BASE_URL="http://localhost:11434/v1"
#   LLM_API_KEY="ollama"
#   LLM_MODEL="qwen2.5-coder:7b" (or "llama3.2")
#
# For OpenAI:
#   LLM_BASE_URL="https://api.openai.com/v1"
#   LLM_API_KEY="sk-proj-..."
#   LLM_MODEL="gpt-4o-mini"
#
# For DeepSeek:
#   LLM_BASE_URL="https://api.deepseek.com/v1"
#   LLM_API_KEY="sk-..."
#   LLM_MODEL="deepseek-chat"

LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="your_api_key_here"
LLM_MODEL="llama-3.3-70b-versatile"

# 2. Project Topic & Description
# Give any Agentic AI topic you want the agent to build step-by-step
PROJECT_TOPIC="Autonomous Multi-Agent Workflow Engine with Tool Calling, Dynamic Memory and Self-Reflection"

# 3. Target Workspace
# Where should the agent write and commit the generated project?
# If "./target_project", it creates a dedicated repository folder.
# If ".", it writes directly into this current repository.
TARGET_PROJECT_PATH="./target_project"

# 4. Git Automation Settings
# Automatically push commits to remote (origin)? Set to false if you want local commits only first.
GIT_AUTO_PUSH=true
GIT_REMOTE="origin"
GIT_BRANCH="main"

# Optional: Override Git Author Identity (Leave empty to use current system git config)
GIT_AUTHOR_NAME=""
GIT_AUTHOR_EMAIL=""

# 5. Randomized 24-Hour Scheduling (In Hours)
# To simulate realistic developer behavior at varying times of day
# The scheduler will pick a random duration between MIN and MAX hours (e.g. between 18 and 28 hrs)
MIN_HOURS_BETWEEN_COMMITS=18
MAX_HOURS_BETWEEN_COMMITS=28
